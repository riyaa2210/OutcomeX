# ══════════════════════════════════════════════════════════════════════════════
# MeetTrack — Production Environment (Render / any cloud host)
# Copy this to .env.production and fill in all values before deploying.
# NEVER commit a file with real secrets to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# Render PostgreSQL: copy the "Internal Database URL" from your Render DB page
# Make sure pgvector extension is enabled (run: CREATE EXTENSION vector; once)
DATABASE_URL=postgresql://user:password@dpg-xxxx.oregon-postgres.render.com/meettrack

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-32-char-hex-secret-here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI ────────────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional — enables GPT-4o as secondary LLM
OPENAI_API_KEY=

# ── LLM Router ────────────────────────────────────────────────────────────────
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL=3600

# ── Transcription ─────────────────────────────────────────────────────────────
# On Render (no GPU): use Colab Whisper or AWS Transcribe
# Option A — Colab Whisper (free, ephemeral, needs Colab running)
USE_LOCAL_WHISPER=false
COLAB_API_URL=https://xxxx.ngrok-free.app
COLAB_WHISPER_URL=https://xxxx.ngrok-free.app

# Option B — AWS Transcribe (reliable, costs ~$0.024/min)
# USE_AWS_TRANSCRIBE=true
# TRANSCRIBE_BUCKET=your-s3-bucket
# TRANSCRIBE_ROLE_ARN=arn:aws:iam::ACCOUNT:role/TranscribeRole

# ── Redis (Render Redis) ──────────────────────────────────────────────────────
# Render Redis: copy "Internal Redis URL" from your Render Redis page
REDIS_URL=redis://red-xxxx.oregon-redis.render.com:6379

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of your frontend URL(s)
CORS_ORIGINS=https://meettrack-frontend.onrender.com

# ── AWS (optional) ────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
TRANSCRIBE_BUCKET=your-s3-bucket
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:ACCOUNT_ID:TopicName
USE_AWS_TRANSCRIBE=false

# ── Automation (optional) ─────────────────────────────────────────────────────
ACTIVEPIECES_WEBHOOK_URL=https://your-activepieces.com/api/v1/webhooks/FLOW_ID
ACTIVEPIECES_SECRET=your-hmac-secret-here

# ── Celery Flower monitoring ──────────────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=your-secure-flower-password

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://meettrack-frontend.onrender.com
BACKEND_URL=https://meettrack-backend.onrender.com

# ── OAuth Integrations (optional) ────────────────────────────────────────────
# Google (Calendar, Meet, Tasks)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Zoom
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=

# Microsoft Teams
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common

# Trello / Notion / Jira
TRELLO_API_KEY=
TRELLO_API_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
